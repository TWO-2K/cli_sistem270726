{
  "name": "clinica-plus",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:estetica": "npm run dev --workspace=apps/web-estetica",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:estetica": "npm run build --workspace=apps/web-estetica",
    "build:admin": "npm run build --workspace=apps/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "kill-port": "^2.0.1"
  }
}
